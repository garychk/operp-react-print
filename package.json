{
  "name": "@operp/print-designer",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "description": "一个功能强大的打印模板设计器组件，支持拖拽、数据绑定和打印预览",
  "main": "./dist/print-designer.umd.js",
  "module": "./dist/print-designer.es.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/print-designer.es.js",
      "require": "./dist/print-designer.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:lib": "vite build"
  },
  "keywords": [
    "print",
    "designer",
    "template",
    "react",
    "print-designer",
    "label-designer"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "antd": ">=5.0.0",
    "@ant-design/icons": ">=5.0.0",
    "react-grid-layout": ">=1.5.0",
    "react-to-print": ">=3.0.0",
    "zustand": ">=5.0.0"
  },
  "dependencies": {
    "react-grid-layout": "^1.5.0",
    "react-resizable": "^3.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.2",
    "vite": "^6.0.0"
  }
}
